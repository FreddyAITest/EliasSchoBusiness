---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = 'Elias Scho — Creative Development & Playground',
  description = 'Personal playground and creative development laboratory by Elias Scho. Experimental frontend mechanics, spatial UI, and interactive prototypes.',
  canonical
} = Astro.props;

const siteUrl = 'https://eliasscho.de';
const fullCanonical = canonical ? `${siteUrl}${canonical}` : siteUrl;
---

<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Elias Scho" />
    <meta name="robots" content="index, follow" />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={fullCanonical} />
    
    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="de_DE" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/Logo.png" />
    
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    
    <title>{title}</title>
  </head>
  <body class="selection:bg-neutral-900 selection:text-neutral-50 antialiased">
    <!-- Accessibility Skip Link -->
    <a href="#main-content" class="skip-link">Zum Inhalt springen</a>
    
    <!-- Minimalist Header -->
    <header class="sticky top-0 z-50 w-full border-b border-[var(--border)] bg-[#fbfaf8]/85 backdrop-blur-md transition-all">
      <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group text-decoration-none">
          <span class="font-semibold text-neutral-900 tracking-tight text-base group-hover:text-neutral-600 transition-colors">elias scho</span>
          <span class="font-mono text-[10px] tracking-wider uppercase px-2 py-0.5 rounded-full border border-[var(--border)] bg-neutral-100 text-neutral-600">
            lab
          </span>
        </a>
        
        <!-- Desktop Nav -->
        <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-neutral-600" aria-label="Hauptnavigation">
          <a href="/#playground" class="hover:text-neutral-950 transition-colors">Playground</a>
          <a href="/#experiments" class="hover:text-neutral-950 transition-colors">Experiments</a>
          <a href="/#about" class="hover:text-neutral-950 transition-colors">About</a>
          <a href="/#connect" class="hover:text-neutral-950 transition-colors">Connect</a>
        </nav>
        
        <!-- Status Indicator -->
        <div class="hidden sm:flex items-center gap-2 text-xs font-mono text-neutral-500">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Hamburg, DE</span>
        </div>
        
        <!-- Mobile Menu Toggle Button -->
        <button 
          id="mobile-nav-toggle"
          class="md:hidden p-2 text-neutral-700 hover:text-neutral-950 focus:outline-none"
          aria-label="Menü öffnen"
          aria-expanded="false"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 6h16M4 12h16m-7 6h7"></path>
          </svg>
        </button>
      </div>
      
      <!-- Mobile Dropdown -->
      <div id="mobile-nav-menu" class="hidden md:hidden border-b border-[var(--border)] bg-[#fbfaf8] px-6 py-4 flex flex-col gap-3 text-sm font-medium text-neutral-700">
        <a href="/#playground" class="py-1 hover:text-neutral-950">Playground</a>
        <a href="/#experiments" class="py-1 hover:text-neutral-950">Experiments</a>
        <a href="/#about" class="py-1 hover:text-neutral-950">About</a>
        <a href="/#connect" class="py-1 hover:text-neutral-950">Connect</a>
        <div class="pt-3 border-t border-[var(--border)] text-xs font-mono text-neutral-500 flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          <span>Hamburg, DE · 53.55° N</span>
        </div>
      </div>
    </header>
    
    <!-- Main Content Slot -->
    <main id="main-content">
      <slot />
    </main>
    
    <!-- Quiet Minimalist Footer -->
    <footer class="border-t border-[var(--border)] bg-[#f5f4ef] mt-24 py-12 text-sm text-neutral-500">
      <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="flex items-center gap-3">
          <span class="font-mono text-xs text-neutral-400">© {new Date().getFullYear()}</span>
          <span class="text-neutral-700 font-medium">Elias Scho</span>
          <span class="text-neutral-400 text-xs">— Creative Development Lab</span>
        </div>
        
        <div class="flex items-center gap-6 text-xs text-neutral-500">
          <a href="/impressum" class="hover:text-neutral-900 transition-colors">Impressum</a>
          <a href="/datenschutz" class="hover:text-neutral-900 transition-colors">Datenschutz</a>
          <a href="/cookie-einstellungen" class="hover:text-neutral-900 transition-colors">Cookies</a>
        </div>
      </div>
    </footer>
    
    <script>
      const toggle = document.getElementById('mobile-nav-toggle');
      const menu = document.getElementById('mobile-nav-menu');
      if (toggle && menu) {
        toggle.addEventListener('click', () => {
          const isOpen = !menu.classList.contains('hidden');
          menu.classList.toggle('hidden');
          toggle.setAttribute('aria-expanded', (!isOpen).toString());
        });
        menu.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', () => {
            menu.classList.add('hidden');
            toggle.setAttribute('aria-expanded', 'false');
          });
        });
      }
    </script>
  </body>
</html>
