---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = 'Elias Scho',
  description = 'Elias Scho — Software & Creative Development aus Hamburg.',
  canonical
} = Astro.props;

const siteUrl = 'https://eliasscho.de';
const fullCanonical = canonical ? `${siteUrl}${canonical}` : siteUrl;
---

<!DOCTYPE html>
<html lang="de" class="bg-[#fbfaf8] text-neutral-900 antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Elias Scho" />
    <meta name="robots" content="index, follow" />
    
    <link rel="canonical" href={fullCanonical} />
    
    <meta property="og:type" content="website" />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="de_DE" />
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/Logo.png" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    
    <title>{title}</title>
  </head>
  <body class="bg-[#fbfaf8] text-neutral-900 min-h-screen flex flex-col justify-between selection:bg-neutral-200 selection:text-neutral-900">
    <!-- Header -->
    <header class="w-full border-b border-neutral-200/70 bg-[#fbfaf8]/90 sticky top-0 z-40 backdrop-blur-sm">
      <div class="max-w-3xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href="/" class="font-medium text-neutral-900 text-sm tracking-tight hover:text-neutral-500 transition-colors">
          elias scho
        </a>
        <div class="flex items-center gap-4 text-xs text-neutral-500">
          <span class="inline-flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            Hamburg
          </span>
          <a href="mailto:kontakt@eliasscho.de" class="hidden sm:inline hover:text-neutral-900 transition-colors">kontakt@eliasscho.de</a>
        </div>
      </div>
    </header>

    <!-- Main -->
    <main class="flex-grow max-w-3xl mx-auto px-6 w-full">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="w-full border-t border-neutral-200/70 py-8 mt-24 text-xs text-neutral-400">
      <div class="max-w-3xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
        <span>© {new Date().getFullYear()} Elias Scho</span>
        <div class="flex items-center gap-4 text-neutral-500">
          <a href="/impressum" class="hover:text-neutral-900 transition-colors">Impressum</a>
          <a href="/datenschutz" class="hover:text-neutral-900 transition-colors">Datenschutz</a>
        </div>
      </div>
    </footer>
  </body>
</html>
