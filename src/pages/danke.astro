---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Vielen Dank - Elias Scho" canonical="/danke">
  <section class="section" style="background: linear-gradient(135deg, #f8f9fa 0%, #fff 100%); min-height: 80vh; display: flex; align-items: center;">
    <div class="container">
      <div style="max-width: 800px; margin: 0 auto; text-align: center; background: white; padding: 3rem; border-radius: 1rem; box-shadow: 0 10px 30px rgba(0,0,0,0.1);">
        <div style="font-size: 4rem; color: #28a745; margin-bottom: 1.5rem;">
          <svg width="80" height="80" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm-1.25 17.292l-4.5-4.364 1.857-1.858 2.643 2.506 5.643-5.784 1.857 1.857-7.5 7.643z"/>
          </svg>
        </div>
        
        <h1 style="margin-bottom: 1rem;">Vielen Dank für Ihre Nachricht!</h1>
        
        <p style="font-size: 1.2rem; color: #666; margin-bottom: 2rem;">
          Ihre Anfrage wurde erfolgreich übermittelt. Ich werde mich schnellstmöglich bei Ihnen melden, 
          in der Regel innerhalb von 24 Stunden.
        </p>
        
        <div style="background: #f8f9fa; padding: 2rem; border-radius: 0.5rem; margin-bottom: 2rem; text-align: left;">
          <h3 style="margin-top: 0; margin-bottom: 1.5rem; text-align: center;">Wie geht es weiter?</h3>
          
          <div style="display: grid; gap: 1.5rem;">
            <div style="display: flex; gap: 1rem; align-items: flex-start;">
              <div style="background: #000; color: white; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 600; flex-shrink: 0;">
                1
              </div>
              <div>
                <h4 style="margin-bottom: 0.5rem;">Erste Kontaktaufnahme</h4>
                <p style="margin-bottom: 0; color: #666;">
                  Ich melde mich bei Ihnen für ein erstes Gespräch über Ihr Projekt.
                </p>
              </div>
            </div>
            
            <div style="display: flex; gap: 1rem; align-items: flex-start;">
              <div style="background: #000; color: white; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 600; flex-shrink: 0;">
                2
              </div>
              <div>
                <h4 style="margin-bottom: 0.5rem;">Projektplanung</h4>
                <p style="margin-bottom: 0; color: #666;">
                  Gemeinsam entwickeln wir ein Konzept für Ihre Website.
                </p>
              </div>
            </div>
            
            <div style="display: flex; gap: 1rem; align-items: flex-start;">
              <div style="background: #000; color: white; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 600; flex-shrink: 0;">
                3
              </div>
              <div>
                <h4 style="margin-bottom: 0.5rem;">Umsetzung</h4>
                <p style="margin-bottom: 0; color: #666;">
                  Ich erstelle Ihre professionelle Website nach Ihren Wünschen.
                </p>
              </div>
            </div>
          </div>
        </div>
        
        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
          <a href="/" class="btn btn-primary">Zurück zur Startseite</a>
          <a href="/#services" class="btn btn-secondary">Dienstleistungen ansehen</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
