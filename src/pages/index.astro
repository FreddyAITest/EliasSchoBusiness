---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Elias Scho">
  <!-- Intro Hero -->
  <section class="pt-16 pb-12 sm:pt-24 sm:pb-16 border-b border-neutral-200/70">
    <div class="flex items-center gap-4 mb-6">
      <img 
        src="/Elias_Icon.png" 
        alt="Elias Scho" 
        class="w-14 h-14 rounded-full object-cover border border-neutral-200 shadow-xs" 
        loading="eager"
      />
      <div>
        <h1 class="text-xl sm:text-2xl font-semibold tracking-tight text-neutral-900">Elias Scho</h1>
        <p class="text-xs sm:text-sm text-neutral-500">Software & Creative Development · Hamburg</p>
      </div>
    </div>

    <p class="text-base sm:text-lg text-neutral-700 leading-relaxed max-w-2xl font-normal">
      Hi, ich bin Elias. Ich entwickle Software und beschäftige mich gerne mit modernen Web-Technologien, Automatisierung und Interfaces.
    </p>
    <p class="text-sm sm:text-base text-neutral-500 leading-relaxed max-w-2xl mt-4">
      Diese Seite ist meine persönliche Spielwiese — komplett befreit von Dienstleistungen oder Verkaufsangeboten. Ich nutze diesen Raum, um neue Frontend-Ideen, interaktive Spielereien und zukünftige Experimente auszuprobieren.
    </p>
  </section>

  <!-- Projects & Experiments -->
  <section class="py-12 border-b border-neutral-200/70">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-xs font-mono tracking-wider uppercase text-neutral-400">Spielwiese & Projekte</h2>
      <span class="text-xs font-mono text-neutral-400">01 / 03</span>
    </div>

    <div class="space-y-4">
      <!-- Item 1: 3D Spatial Canvas -->
      <div class="group p-5 rounded-xl border border-neutral-200/80 bg-white hover:border-neutral-300 transition-all">
        <div class="flex items-start justify-between gap-4">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <h3 class="font-medium text-neutral-900 text-sm sm:text-base">Spatial Scroll & 3D Lab</h3>
              <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded-full bg-neutral-100 text-neutral-600 border border-neutral-200">
                In Arbeit
              </span>
            </div>
            <p class="text-xs sm:text-sm text-neutral-500 leading-relaxed mt-1">
              Scroll-gesteuerte 3D-Geometrien, Canvas-Shader und räumliche Interaktionen im Browser.
            </p>
          </div>
        </div>
      </div>

      <!-- Item 2: ApeUI -->
      <div class="group p-5 rounded-xl border border-neutral-200/80 bg-white hover:border-neutral-300 transition-all">
        <div class="flex items-start justify-between gap-4">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <h3 class="font-medium text-neutral-900 text-sm sm:text-base">ApeUI</h3>
              <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded-full bg-neutral-100 text-neutral-600 border border-neutral-200">
                Interface
              </span>
            </div>
            <p class="text-xs sm:text-sm text-neutral-500 leading-relaxed mt-1">
              Komponenten-Design und Interface-Architektur für moderne Web-Tools.
            </p>
          </div>
        </div>
      </div>

      <!-- Item 3: ImmoGame -->
      <div class="group p-5 rounded-xl border border-neutral-200/80 bg-white hover:border-neutral-300 transition-all">
        <div class="flex items-start justify-between gap-4">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <h3 class="font-medium text-neutral-900 text-sm sm:text-base">ImmoGame</h3>
              <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded-full bg-neutral-100 text-neutral-600 border border-neutral-200">
                Simulation
              </span>
            </div>
            <p class="text-xs sm:text-sm text-neutral-500 leading-relaxed mt-1">
              Interaktive Immobilien- und Wirtschafts-Simulation im Web.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Connect & Links -->
  <section class="py-12">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-xs font-mono tracking-wider uppercase text-neutral-400">Netzwerk & Links</h2>
      <span class="text-xs font-mono text-neutral-400">02 / 03</span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <a 
        href="https://github.com/FreddyAITest" 
        target="_blank" 
        rel="noopener noreferrer"
        class="p-4 rounded-xl border border-neutral-200/80 bg-white hover:border-neutral-400 hover:bg-neutral-50/50 transition-all no-underline group block"
      >
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-mono uppercase text-neutral-400">Code</span>
          <span class="text-xs text-neutral-400 group-hover:text-neutral-900 transition-colors">↗</span>
        </div>
        <div class="text-sm font-medium text-neutral-900">GitHub</div>
        <div class="text-xs text-neutral-500 mt-0.5">@FreddyAITest</div>
      </a>

      <a 
        href="https://www.linkedin.com/in/elias-scho" 
        target="_blank" 
        rel="noopener noreferrer"
        class="p-4 rounded-xl border border-neutral-200/80 bg-white hover:border-neutral-400 hover:bg-neutral-50/50 transition-all no-underline group block"
      >
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-mono uppercase text-neutral-400">Profil</span>
          <span class="text-xs text-neutral-400 group-hover:text-neutral-900 transition-colors">↗</span>
        </div>
        <div class="text-sm font-medium text-neutral-900">LinkedIn</div>
        <div class="text-xs text-neutral-500 mt-0.5">Elias Scho</div>
      </a>

      <a 
        href="mailto:kontakt@eliasscho.de" 
        class="p-4 rounded-xl border border-neutral-200/80 bg-white hover:border-neutral-400 hover:bg-neutral-50/50 transition-all no-underline group block"
      >
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-mono uppercase text-neutral-400">Kontakt</span>
          <span class="text-xs text-neutral-400 group-hover:text-neutral-900 transition-colors">↗</span>
        </div>
        <div class="text-sm font-medium text-neutral-900">E-Mail</div>
        <div class="text-xs text-neutral-500 mt-0.5">kontakt@eliasscho.de</div>
      </a>
    </div>
  </section>
</Layout>
